# LUBESTATION — Apache / LiteSpeed configuration (lubestation.ir, site in public_html root).

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType font/woff .woff
AddType font/ttf .ttf
AddType image/webp .webp
AddType text/javascript .js

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS and bare domain: enable once the SSL certificate is active on the host ---
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://lubestation.ir%{REQUEST_URI} [L,R=301]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^ https://lubestation.ir%{REQUEST_URI} [L,R=301]

  # Old page addresses from the previous site.
  RewriteRule ^(corporate-governance|partner-ecosystem|technical-support|scheme-overview|core-operations)\.html$ /$1 [L,R=301]
  RewriteRule ^(home|index|dst-lubestation-hero)\.html$ / [L,R=301]

  # Single-page app: every path that is not a real file (and not the API) serves index.html.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  # Enable together with the HTTPS redirect above:
  # Header always set Strict-Transport-Security "max-age=31536000"

  # Fingerprinted build files (name-HASH.ext) never change: cache for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf|png|jpe?g|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The page shell and the template must always be revalidated so updates show at once.
  <FilesMatch "\.(html|xlsx|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json font/ttf image/svg+xml application/xml
</IfModule>

# Source maps, dotfiles and editor leftovers are never served.
<FilesMatch "(^\.|\.(map|bak|log|md)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

ErrorDocument 404 /index.html
